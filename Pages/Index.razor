@page "/"
@implements IAsyncDisposable

<div class="app-container">
    <header class="app-header">
        <div class="wordmark" aria-label="relexx Template Generator">
            <span class="wordmark-glyph">
                <svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="1" y="1" width="20" height="20" rx="2" stroke="currentColor" stroke-opacity="0.18" stroke-width="1"/>
                    <path d="M5 16 L5 6 L11 6 L11 11 L16 16" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
                    <rect x="14" y="5" width="3" height="3" fill="var(--color-accent)"/>
                </svg>
            </span>
            <span class="wordmark-text">
                <span class="accent">relexx</span><span class="wordmark-tmpl">_tmpl</span><span class="cursor"></span>
            </span>
        </div>

        <div class="header-center">
            <span class="header-title">@(string.IsNullOrWhiteSpace(article.Title) ? "Neuer Artikel" : article.Title)</span>
            <span class="header-divider">│</span>
            <span class="header-layout">@currentLayout.Name</span>
        </div>

        <div class="stepper" role="tablist">
            @for (var i = 0; i <= 3; i++)
            {
                var phase = i;
                var isActive = currentPhase == phase;
                var isDone = phase < currentPhase || (_maxReached >= phase && phase != currentPhase);
                <button class="step @(isActive ? "is-active" : "") @(isDone && !isActive ? "is-done" : "")"
                        @onclick="async () => { if (phase <= _maxReached + 1) await GoToPhase(phase); }"
                        role="tab" aria-selected="@isActive" disabled="@(phase > _maxReached + 1)">
                    <span class="step-num">@phase</span>
                    @GetPhaseName(phase)
                </button>
                @if (i < 3)
                {
                    <span class="step-connector @(currentPhase > phase ? "is-done" : "")" aria-hidden="true"></span>
                }
            }
        </div>

        <div class="stepper-mobile" role="navigation" id="stepper-flyout-container">
            <button class="phase-nav-btn" @onclick="async () => { if (currentPhase > 0) await GoToPhase(currentPhase - 1); }"
                    disabled="@(currentPhase == 0)" aria-label="Zurück">&#8249;</button>
            <button class="phase-mobile-current" @onclick="ToggleStepperFlyout" aria-haspopup="true" aria-expanded="@_showStepperFlyout">
                <span class="phase-mobile-num">@currentPhase</span>
                <span class="phase-mobile-label">@GetPhaseName(currentPhase)</span>
                <span class="phase-mobile-chevron">▾</span>
            </button>
            <button class="phase-nav-btn" @onclick="async () => { if (currentPhase < 3 && currentPhase < _maxReached + 1) await GoToPhase(currentPhase + 1); }"
                    disabled="@(currentPhase == 3 || currentPhase >= _maxReached + 1)" aria-label="Weiter">&#8250;</button>
            <div class="stepper-flyout @(_showStepperFlyout ? "open" : "")" role="menu">
                @for (var i = 0; i <= 3; i++)
                {
                    var phase = i;
                    var isActive  = currentPhase == phase;
                    var isDone    = phase < currentPhase || (_maxReached >= phase && phase != currentPhase);
                    var isLocked  = phase > _maxReached + 1;
                    <button class="stepper-flyout-item @(isActive ? "is-active" : "") @(isDone && !isActive ? "is-done" : "")"
                            @onclick="async () => { _showStepperFlyout = false; if (!isLocked) await GoToPhase(phase); }"
                            disabled="@isLocked" role="menuitem">
                        <span class="step-num">@phase</span>
                        @GetPhaseName(phase)
                    </button>
                }
            </div>
        </div>

        <div id="settings-container" style="position:relative; flex-shrink:0;">
            <button class="settings-btn @(_showSettings ? "open" : "")"
                    @onclick="ToggleSettings"
                    title="Einstellungen">
                <Icon Name="settings" Size="16" />
            </button>
            <div class="settings-flyout @(_showSettings ? "open" : "")">
                <div class="settings-section">
                    <span class="settings-section-label">Theme</span>
                    <div class="settings-toggle-row">
                        <button class="settings-toggle-btn @(_theme == "dark" ? "active" : "")"
                                @onclick='async () => await SetTheme("dark")'>
                            <Icon Name="moon" Size="13" /> Dark
                        </button>
                        <button class="settings-toggle-btn @(_theme == "light" ? "active" : "")"
                                @onclick='async () => await SetTheme("light")'>
                            <Icon Name="sun" Size="13" /> Light
                        </button>
                    </div>
                </div>
                <div class="settings-section">
                    <span class="settings-section-label">Dichte</span>
                    <div class="settings-toggle-row">
                        <button class="settings-toggle-btn @(_density == "comfortable" ? "active" : "")"
                                @onclick='async () => await SetDensity("comfortable")'>
                            Komfort
                        </button>
                        <button class="settings-toggle-btn @(_density == "compact" ? "active" : "")"
                                @onclick='async () => await SetDensity("compact")'>
                            Kompakt
                        </button>
                    </div>
                </div>
                <div class="settings-section">
                    <span class="settings-section-label">Akzentfarbe</span>
                    <div class="accent-swatches">
                        @foreach (var preset in AccentPresets)
                        {
                            <button class="accent-swatch @(_accentPreset == preset.Key ? "active" : "")"
                                    style="background: @preset.Value.Hex"
                                    title="@preset.Key"
                                    @onclick="async () => await SetAccent(preset.Key)">
                            </button>
                        }
                    </div>
                </div>
                <div class="settings-section">
                    <span class="settings-section-label">Animationen</span>
                    <div class="settings-toggle-row">
                        <button class="settings-toggle-btn @(_animationsEnabled ? "active" : "")"
                                @onclick="ToggleAnimations">
                            <Icon Name="zap" Size="13" /> An
                        </button>
                        <button class="settings-toggle-btn @(!_animationsEnabled ? "active" : "")"
                                @onclick="ToggleAnimations">
                            Aus
                        </button>
                    </div>
                </div>
                <div class="settings-section settings-section-about">
                    <button class="settings-about-btn settings-about-btn--danger" @onclick="AskClearAllData">
                        <Icon Name="trash" Size="13" /> Alle lokalen Daten entfernen
                    </button>
                    <button class="settings-about-btn" @onclick="OpenAbout">
                        <Icon Name="info" Size="13" /> Über die App
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="app-main">
        @switch (currentPhase)
        {
            case 0: @RenderLayoutPhase() break;
            case 1: @RenderInputPhase()  break;
            case 2: @RenderPreviewPhase() break;
            case 3: @RenderHtmlPhase()   break;
        }
    </main>
</div>

@RenderDialogs()
@RenderNotification()

@code {
    private RenderFragment RenderLayoutPhase() => __builder =>
    {
        <div class="phase-content layout-phase @PhaseAnimClass">
            <div class="page-head">
                <div class="page-head-title">
                    <h1>Layout</h1>
                    <p class="page-sub">Blöcke definieren und Farbschema festlegen</p>
                </div>
                <div class="page-head-actions">
                    <div class="page-actions-strip" id="layout-actions-overflow">
                        <div class="btn-stack">
                            <button class="btn btn-secondary" @onclick="() => OpenLayoutDialog(LayoutDialogMode.New)" title="Neues Layout">
                                <Icon Name="plus" Size="14" /> Neu
                            </button>
                            <button class="btn btn-secondary" @onclick="() => OpenLayoutDialog(LayoutDialogMode.Rename)" title="Layout umbenennen"
                                    disabled="@currentLayout.IsDefault">
                                <Icon Name="edit" Size="14" /> Umbenennen
                            </button>
                            <button class="btn btn-secondary page-actions-secondary" @onclick="() => OpenLayoutDialog(LayoutDialogMode.Duplicate)" title="Duplizieren">
                                <Icon Name="copy" Size="14" /> Duplizieren
                            </button>
                            <button class="btn btn-secondary page-actions-secondary" @onclick="ExportLayout" title="Exportieren">
                                <Icon Name="download" Size="14" /> Export
                            </button>
                            <button class="btn btn-secondary page-actions-secondary" title="Importieren"
                                    @onclick='() => JS.InvokeVoidAsync("triggerClick", "layout-import")'>
                                <Icon Name="upload" Size="14" /> Import
                            </button>
                            <button class="btn btn-danger btn-secondary page-actions-secondary"
                                    @onclick='() => AskConfirm("Layout löschen", $"Layout «{currentLayout.Name}» wird dauerhaft gelöscht. Alle enthaltenen Blöcke gehen verloren.", DeleteLayout)'
                                    disabled="@(currentLayout.IsDefault || layouts.Count <= 1)"
                                    title="Layout löschen">
                                <Icon Name="trash" Size="14" /> Löschen
                            </button>
                            <button class="btn btn-secondary page-actions-more-btn"
                                    @onclick='async () => await ToggleActionsOverflow("layout-actions-overflow")'
                                    title="Weitere Aktionen">···</button>
                        </div>
                        <div class="page-actions-flyout @(_showActionsOverflow ? "open" : "")">
                            <button class="btn btn-secondary" @onclick="async () => { _showActionsOverflow = false; OpenLayoutDialog(LayoutDialogMode.Duplicate); }">
                                <Icon Name="copy" Size="14" /> Duplizieren
                            </button>
                            <button class="btn btn-secondary" @onclick="async () => { _showActionsOverflow = false; await ExportLayout(); }">
                                <Icon Name="download" Size="14" /> Export
                            </button>
                            <button class="btn btn-secondary" @onclick='async () => { _showActionsOverflow = false; await JS.InvokeVoidAsync("triggerClick", "layout-import"); }'>
                                <Icon Name="upload" Size="14" /> Import
                            </button>
                            <button class="btn btn-danger btn-secondary"
                                    @onclick='() => { _showActionsOverflow = false; AskConfirm("Layout löschen", $"Layout «{currentLayout.Name}» wird dauerhaft gelöscht. Alle enthaltenen Blöcke gehen verloren.", DeleteLayout); }'
                                    disabled="@(currentLayout.IsDefault || layouts.Count <= 1)">
                                <Icon Name="trash" Size="14" /> Löschen
                            </button>
                        </div>
                    </div>
                    <InputFile id="layout-import" OnChange="ImportLayout" accept=".json" style="display:none" />
                </div>
            </div>

            <div class="toolbar">
                <select class="layout-select" @bind="selectedLayoutId" @bind:after="OnLayoutSelected">
                    @foreach (var l in layouts)
                    {
                        <option value="@l.Id">@l.Name @(l.IsDefault ? "(Standard)" : "")</option>
                    }
                </select>
                <span class="toolbar-meta"><span @key="@($"cnt-{currentLayout.Blocks.Count}")" class="meta-count">@currentLayout.Blocks.Count Blöcke</span> · @GetRelativeTime(currentLayout.ModifiedAt)</span>
            </div>

            <div class="layout-editor">
                <div class="layout-split">
                    <div class="layout-sidebar">
                        <Panel Title="Blöcke" Icon="blocks" Badge="@currentLayout.Blocks.Count.ToString()">
                            <Actions>
                                <button class="btn btn-small btn-accent" @onclick="() => _showAddBlockDialog = true" title="Block hinzufügen">
                                    <Icon Name="plus" Size="14" />
                                </button>
                            </Actions>
                            <ChildContent>
                                <div class="block-list" id="block-list">
                                    @foreach (var block in currentLayout.Blocks.OrderBy(b => b.Order))
                                    {
                                        <div @key="block.Id"
                                             class="block-item @(selectedBlockId == block.Id ? "selected" : "") @(_newlyAddedBlockId == block.Id ? "block-enter" : "") @(_removingBlockIds.Contains(block.Id) ? "block-exit" : "")"
                                             data-id="@block.Id"
                                             @onclick="() => SelectBlock(block)">
                                            <span class="drag-handle"><Icon Name="gripVert" Size="14" /></span>
                                            <span class="block-icon">
                                                @if (IconHelper.Has(block.Icon))
                                                { <Icon Name="@block.Icon" Size="16" /> }
                                                else
                                                { <span>@block.Icon</span> }
                                            </span>
                                            <span class="block-title">@block.Title</span>
                                            <span class="block-type">@block.Type.GetDisplayName()</span>
                                        </div>
                                    }
                                </div>
                            </ChildContent>
                        </Panel>
                    </div>

                    <Panel Title="@(SelectedBlock is not null ? "Block bearbeiten" : "Block-Editor")"
                           Icon="edit"
                           Badge="@SelectedBlock?.Id">
                        <Actions>
                            @if (SelectedBlock is not null)
                            {
                                <button class="btn btn-danger btn-small"
                                        @onclick='() => AskConfirm("Block löschen", $"Block «{SelectedBlock!.Title}» wird dauerhaft aus dem Layout entfernt.", DeleteBlock)'
                                        title="Block löschen">
                                    <Icon Name="trash" Size="14" />
                                </button>
                            }
                        </Actions>
                        <ChildContent>
                        @if (SelectedBlock is not null)
                        {
                            <Field Label="Id" Hint="Eindeutiger Bezeichner für JSON-Export">
                                <input type="text" value="@SelectedBlock.Id" class="mono @(!string.IsNullOrEmpty(_blockIdError) ? "input-error" : string.Empty)"
                                       @onchange="async e => await ChangeBlockId(SelectedBlock, e.Value?.ToString() ?? string.Empty)"
                                       placeholder="block-id" />
                                @if (!string.IsNullOrEmpty(_blockIdError))
                                {
                                    <span class="field-error">@_blockIdError</span>
                                }
                            </Field>

                            <Field Label="Block-Typ">
                                <select @bind="SelectedBlock.Type" @bind:after="OnBlockTypeChanged">
                                    @foreach (BlockType t in Enum.GetValues<BlockType>())
                                    {
                                        <option value="@t">@t.GetDisplayName()</option>
                                    }
                                </select>
                            </Field>

                            <Field Label="Icon">
                                <div class="icon-picker">
                                    @foreach (var cat in Constants.IconCategories)
                                    {
                                        <div class="icon-picker-group">
                                            <div class="icon-picker-label">@cat.Label</div>
                                            <div class="icon-picker-tiles">
                                                @foreach (var iconName in cat.Icons)
                                                {
                                                    <button type="button" class="icon-tile @(SelectedBlock.Icon == iconName ? "is-active" : "")"
                                                            @onclick="() => SetBlockIcon(iconName)" title="@iconName">
                                                        <Icon Name="@iconName" Size="18" StrokeWidth="1.6" />
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </Field>

                            <Field Label="Überschrift">
                                <input type="text" @bind="SelectedBlock.Title" @bind:after="SaveLayouts" />
                            </Field>

                            @RenderBlockOptions(SelectedBlock)
                        }
                        else
                        {
                            <div class="no-selection">
                                <p>Wähle einen Block aus der Liste.</p>
                                <p>Blöcke per Drag & Drop neu anordnen.</p>
                            </div>
                        }
                        </ChildContent>
                    </Panel>
                </div>

                <Panel Title="Farbschema" Icon="palette">
                    <div class="color-panel-fields">
                        <Field Label="Primär">
                            <div class="color-row">
                                <input type="color" @bind="currentLayout.Colors.PrimaryColor" @bind:after="SaveLayouts" />
                                <input type="text" class="color-text mono" @bind="currentLayout.Colors.PrimaryColor" @bind:after="SaveLayouts" />
                            </div>
                        </Field>
                        <Field Label="Akzent">
                            <div class="color-row">
                                <input type="color" @bind="currentLayout.Colors.AccentColor" @bind:after="SaveLayouts" />
                                <input type="text" class="color-text mono" @bind="currentLayout.Colors.AccentColor" @bind:after="SaveLayouts" />
                            </div>
                        </Field>
                        <Field Label="Hintergrund">
                            <div class="color-row">
                                <input type="color" @bind="currentLayout.Colors.BackgroundColor" @bind:after="SaveLayouts" />
                                <input type="text" class="color-text mono" @bind="currentLayout.Colors.BackgroundColor" @bind:after="SaveLayouts" />
                            </div>
                        </Field>
                    </div>
                </Panel>
            </div>

            <div class="stage-foot">
                <div class="stage-foot-spacer"></div>
                <button class="btn btn-accent btn-large" @onclick="() => GoToPhase(1)">
                    Eingabe <Icon Name="arrowRight" Size="16" />
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderBlockOptions(BlockDefinition block) => __builder =>
    {
        <Field>
            <ChildContent>
                <div class="checkbox-group">
                    <label>
                        <input type="checkbox" @bind="block.Options.ShowTitle" @bind:after="SaveLayouts" />
                        Überschrift im Artikel anzeigen
                    </label>
                </div>
            </ChildContent>
        </Field>

        @if (block.Type == BlockType.KeyValueGrid)
        {
            <Field Label="Spalten">
                <select @bind="block.Options.Columns" @bind:after="SaveLayouts">
                    <option value="1">1 Spalte</option>
                    <option value="2">2 Spalten</option>
                    <option value="3">3 Spalten</option>
                </select>
            </Field>
            @RenderBulletPicker(block)
        }

        @if (block.Type == BlockType.DataTable)
        {
            <Field Label="Spalte 1">
                <input type="text" @bind="block.Options.Column1Header" @bind:after="SaveLayouts" />
            </Field>
            <Field Label="Spalte 2">
                <input type="text" @bind="block.Options.Column2Header" @bind:after="SaveLayouts" />
            </Field>
            <Field>
                <ChildContent>
                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" @bind="block.Options.ShowColumnHeaders" @bind:after="SaveLayouts" />
                            Spaltenüberschriften
                        </label>
                    </div>
                </ChildContent>
            </Field>
            <Field>
                <ChildContent>
                    <div class="checkbox-group">
                        <label>
                            <input type="checkbox" @bind="block.Options.AlternatingBackground" @bind:after="SaveLayouts" />
                            Zebra-Streifen
                        </label>
                    </div>
                </ChildContent>
            </Field>
        }

        @if (block.Type == BlockType.CheckList)
        {
            @RenderBulletPicker(block)
        }

        @if (block.Type == BlockType.Image)
        {
            <Field Label="Ausrichtung">
                <select @bind="block.Options.Alignment" @bind:after="SaveLayouts">
                    <option value="left">Links</option>
                    <option value="center">Zentriert</option>
                    <option value="right">Rechts</option>
                </select>
            </Field>
            <Field Label="Max. Breite (px)">
                <input type="number" @bind="block.Options.MaxWidth" @bind:after="SaveLayouts" min="100" max="800" />
            </Field>
        }

        @if (block.Type == BlockType.FixedText)
        {
            <Field Label="Vorlagen-Text (Markdown)" Hint="Standardwert für neue Artikel">
                <textarea rows="6" @bind="block.Options.FixedContent" @bind:after="() => OnFixedContentChanged(block)"
                          placeholder="Fester Text, der im Layout gespeichert wird..."></textarea>
            </Field>
        }

        @if (block.Type == BlockType.CalloutBox)
        {
            <Field Label="Variante">
                <select @bind="block.Options.CalloutVariant" @bind:after="SaveLayouts">
                    <option value="info">ℹ Info (Blau)</option>
                    <option value="warning">⚠ Hinweis (Gelb)</option>
                    <option value="tip">💡 Tipp (Grün)</option>
                    <option value="error">✗ Achtung (Rot)</option>
                </select>
            </Field>
        }

        @if (block.Type == BlockType.Gallery)
        {
            <Field Label="Spalten">
                <select @bind="block.Options.Columns" @bind:after="SaveLayouts">
                    <option value="2">2 Spalten</option>
                    <option value="3">3 Spalten</option>
                    <option value="4">4 Spalten</option>
                </select>
            </Field>
        }

        @if (block.Type == BlockType.HeroBanner)
        {
            <Field Label="Textausrichtung">
                <select @bind="block.Options.Alignment" @bind:after="SaveLayouts">
                    <option value="left">Links</option>
                    <option value="center">Zentriert</option>
                    <option value="right">Rechts</option>
                </select>
            </Field>
            <Field Label="Overlay-Deckkraft">
                <select @bind="block.Options.OverlayOpacity" @bind:after="SaveLayouts">
                    <option value="0">Keiner (0%)</option>
                    <option value="25">Leicht (25%)</option>
                    <option value="50">Mittel (50%)</option>
                    <option value="70">Stark (70%)</option>
                    <option value="85">Sehr stark (85%)</option>
                </select>
            </Field>
        }
    };

    private RenderFragment RenderBulletPicker(BlockDefinition block) => __builder =>
    {
        <Field Label="Aufzählungszeichen">
            <div class="bullet-picker">
                @foreach (var b in Constants.AvailableBullets)
                {
                    <button type="button" class="bullet-btn @(block.Options.BulletChar == b ? "selected" : "")"
                            @onclick="() => SetBullet(b)">@b</button>
                }
            </div>
        </Field>
    };

    private RenderFragment RenderInputPhase() => __builder =>
    {
        <div class="phase-content input-phase @PhaseAnimClass">
            <div class="page-head">
                <div class="page-head-title">
                    <h1>Eingabe</h1>
                    <p class="page-sub">Artikelinhalte befüllen</p>
                </div>
                <div class="page-head-actions">
                    <div class="page-actions-strip" id="input-actions-overflow">
                        <div class="btn-stack">
                            <button class="btn btn-secondary" @onclick="LoadDemo" title="Demo-Daten laden">
                                <Icon Name="sparkles" Size="14" /> Demo
                            </button>
                            <button class="btn btn-secondary" @onclick="CopyJsonSchema" title="JSON-Schema kopieren">
                                <Icon Name="fileJson" Size="14" /> Schema
                            </button>
                            <button class="btn btn-secondary page-actions-secondary" @onclick="ExportArticle" title="Exportieren">
                                <Icon Name="download" Size="14" /> Export
                            </button>
                            <button class="btn btn-secondary page-actions-secondary" title="Importieren"
                                    @onclick='() => JS.InvokeVoidAsync("triggerClick", "article-import")'>
                                <Icon Name="upload" Size="14" /> Import
                            </button>
                            <button class="btn btn-secondary btn-danger page-actions-secondary"
                                    @onclick='() => AskConfirm("Eingaben zurücksetzen", "Alle eingegebenen Inhalte werden auf den Standardzustand zurückgesetzt.", async () => { ResetArticle(); }, "Zurücksetzen")'
                                    title="Zurücksetzen">
                                <Icon Name="refresh" Size="14" /> Zurücksetzen
                            </button>
                            <button class="btn btn-secondary page-actions-more-btn"
                                    @onclick='async () => await ToggleActionsOverflow("input-actions-overflow")'
                                    title="Weitere Aktionen">···</button>
                        </div>
                        <div class="page-actions-flyout @(_showActionsOverflow ? "open" : "")">
                            <button class="btn btn-secondary" @onclick="async () => { _showActionsOverflow = false; await ExportArticle(); }">
                                <Icon Name="download" Size="14" /> Export
                            </button>
                            <button class="btn btn-secondary" @onclick='async () => { _showActionsOverflow = false; await JS.InvokeVoidAsync("triggerClick", "article-import"); }'>
                                <Icon Name="upload" Size="14" /> Import
                            </button>
                            <button class="btn btn-danger btn-secondary"
                                    @onclick='() => { _showActionsOverflow = false; AskConfirm("Eingaben zurücksetzen", "Alle eingegebenen Inhalte werden auf den Standardzustand zurückgesetzt.", async () => { ResetArticle(); }, "Zurücksetzen"); }'>
                                <Icon Name="refresh" Size="14" /> Zurücksetzen
                            </button>
                        </div>
                    </div>
                    <InputFile id="article-import" OnChange="ImportArticle" accept=".json" style="display:none" />
                </div>
            </div>

            <div class="content-grid">
                <Panel Title="Header" Icon="type">
                    <Field Label="Titel">
                        <input type="text" @bind="article.Title" @bind:after="InvalidatePreview" placeholder="Produktname" />
                    </Field>
                    <Field Label="Untertitel" Hint="Kurzbeschreibung · Artikelnummer">
                        <input type="text" @bind="article.Subtitle" @bind:after="InvalidatePreview" placeholder="Kurzbeschreibung │ Artikelnummer" />
                    </Field>
                </Panel>

                <Panel Title="Mobile Summary" Icon="smartphone">
                    <Field Label="Zusammenfassung" Hint="@($"max. {Constants.Limits.MaxMobileSummaryLength} Zeichen")">
                        <textarea @bind="article.MobileSummary" @bind:after="InvalidatePreview" rows="3"
                                  placeholder="Kurze Produktbeschreibung für Mobile..."></textarea>
                        <span class="char-count @(article.MobileSummary?.Length > Constants.Limits.MaxMobileSummaryLength ? "over-limit" : "")">
                            @(article.MobileSummary?.Length ?? 0) / @Constants.Limits.MaxMobileSummaryLength
                        </span>
                    </Field>
                </Panel>

                @foreach (var block in currentLayout.Blocks.OrderBy(b => b.Order))
                {
                    var blockRef = block;
                    <Panel Title="@blockRef.Title" Icon="@(IconHelper.Has(blockRef.Icon) ? blockRef.Icon : "blocks")">
                        <Actions>
                            <button class="btn-clear" @onclick="() => ClearBlock(blockRef.Id)" title="Inhalt löschen">
                                <Icon Name="trash" Size="13" />
                            </button>
                        </Actions>
                        <ChildContent>
                            <Field Label="@blockRef.Type.GetInputLabel()" Hint="@blockRef.Type.GetInputHint()">
                                @if (blockRef.Type == BlockType.Image)
                                {
                                    <div class="dropzone @(string.IsNullOrEmpty(article.GetBlockContent(blockRef.Id)) ? "" : "has-image")"
                                         @ondragover:preventDefault @ondragover="() => {}"
                                         @ondrop:preventDefault @ondrop="async e => await HandleImageDrop(e, blockRef.Id)">
                                        @if (!string.IsNullOrEmpty(article.GetBlockContent(blockRef.Id)))
                                        {
                                            <img src="@article.GetBlockContent(blockRef.Id)" class="dropzone-preview" alt="Vorschau" />
                                        }
                                        else
                                        {
                                            <div class="dropzone-hint">
                                                <Icon Name="image" Size="24" />
                                                <span>Bild hier ablegen</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="input-with-button" style="margin-top:8px">
                                        <input type="text" class="mono" value="@article.GetBlockContent(blockRef.Id)"
                                               @onchange="e => SetContent(blockRef.Id, e)" placeholder="https://..." />
                                        <InputFile id="@($"img-{blockRef.Id}")" OnChange="e => UploadImage(e, blockRef.Id)" accept="image/*" style="display:none" />
                                        <button class="btn btn-accent" @onclick="() => TriggerImagePicker(blockRef.Id)" title="Bild hochladen">
                                            <Icon Name="camera" Size="14" />
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <textarea value="@article.GetBlockContent(blockRef.Id)"
                                              @onchange="e => SetContent(blockRef.Id, e)"
                                              rows="@blockRef.Type.GetTextareaRows()"
                                              placeholder="@blockRef.Type.GetInputPlaceholder()"></textarea>
                                }
                            </Field>
                        </ChildContent>
                    </Panel>
                }

                <Panel Title="Fußzeile" Icon="layoutPanel">
                    <Actions>
                        <button class="btn-clear" @onclick="() => { article.Footer = string.Empty; InvalidatePreview(); }" title="Inhalt löschen">
                            <Icon Name="trash" Size="13" />
                        </button>
                    </Actions>
                    <ChildContent>
                        <Field Label="Einträge" Hint="@($"max. {Constants.Limits.MaxFooterLines} Zeilen · Format: Label: Wert")">
                            <textarea @bind="article.Footer" @bind:after="InvalidatePreview" rows="4"
                                      placeholder="SKU: ABC123&#10;Farbe: Schwarz&#10;Garantie: 2 Jahre"></textarea>
                            <span class="char-count @(GetFooterLines() > Constants.Limits.MaxFooterLines ? "over-limit" : "")">
                                @GetFooterLines() / @Constants.Limits.MaxFooterLines Zeilen
                            </span>
                        </Field>
                    </ChildContent>
                </Panel>
            </div>

            <div class="stage-foot">
                <button class="btn btn-secondary btn-large" @onclick="() => GoToPhase(0)">
                    <Icon Name="arrowLeft" Size="16" /> Layout
                </button>
                <button class="btn btn-accent btn-large" @onclick="() => GoToPhase(2)">
                    Vorschau <Icon Name="arrowRight" Size="16" />
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderPreviewPhase() => __builder =>
    {
        <div class="phase-content preview-phase @PhaseAnimClass">
            <div class="page-head">
                <div class="page-head-title">
                    <h1>Vorschau</h1>
                    <p class="page-sub">Darstellung des generierten eBay-Listings</p>
                </div>
                <div class="page-head-actions">
                    <div class="btn-stack">
                        <button class="btn btn-secondary @(_previewDevice == "desktop" ? "active" : "")"
                                @onclick='() => _previewDevice = "desktop"' title="Desktop-Ansicht">
                            <Icon Name="monitor" Size="14" /> Desktop
                        </button>
                        <button class="btn btn-secondary @(_previewDevice == "mobile" ? "active" : "")"
                                @onclick='() => _previewDevice = "mobile"' title="Mobile-Ansicht">
                            <Icon Name="smartphone" Size="14" /> Mobile
                        </button>
                    </div>
                </div>
            </div>

            <div class="preview-shell">
                <div class="preview-frame @(_previewDevice == "mobile" ? "is-mobile" : "")">
                    <iframe @ref="_previewFrame" class="preview-iframe @(_iframeLoaded ? "is-loaded" : "")" @onload="HandleIframeLoaded" title="Vorschau"></iframe>
                </div>
            </div>

            <div class="stage-foot">
                <button class="btn btn-secondary btn-large" @onclick="() => GoToPhase(1)">
                    <Icon Name="arrowLeft" Size="16" /> Eingabe
                </button>
                <button class="btn btn-accent btn-large" @onclick="() => GoToPhase(3)">
                    HTML <Icon Name="arrowRight" Size="16" />
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderHtmlPhase() => __builder =>
    {
        <div class="phase-content html-phase @PhaseAnimClass">
            <div class="page-head">
                <div class="page-head-title">
                    <h1>HTML</h1>
                    <p class="page-sub">Generierten Code kopieren oder herunterladen</p>
                </div>
                <div class="page-head-actions">
                    <div class="html-badges">
                        <span class="badge badge-mono">@generatedHtml.Length Zeichen</span>
                        <span class="badge badge-mono">@generatedHtml.Split('\n').Length Zeilen</span>
                        <span class="badge badge-mono">@((System.Text.Encoding.UTF8.GetByteCount(generatedHtml) / 1024.0).ToString("F1")) kB</span>
                        <span class="badge">UTF-8 · text/html</span>
                    </div>
                    <div class="btn-stack">
                        <button class="btn btn-secondary" @onclick="CopyHtml">
                            <Icon Name="copy" Size="14" /> Kopieren
                        </button>
                        <button class="btn btn-secondary" @onclick="DownloadHtml">
                            <Icon Name="download" Size="14" /> Herunterladen
                        </button>
                    </div>
                </div>
            </div>

            <div class="html-container">
                <pre class="html-code"><code>@((MarkupString)TemplateGeneratorService.SyntaxHighlightHtml(generatedHtml))</code></pre>
            </div>

            <div class="stage-foot">
                <button class="btn btn-secondary btn-large" @onclick="() => GoToPhase(2)">
                    <Icon Name="arrowLeft" Size="16" /> Vorschau
                </button>
                <button class="btn btn-secondary btn-large" @onclick="StartNewArticle">
                    <Icon Name="refresh" Size="16" /> Neuer Artikel
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderDialogs() => __builder =>
    {
        @if (_showLayoutDialog)
        {
            var dialogTitle = _layoutDialogMode switch {
                LayoutDialogMode.New => "Neues Layout",
                LayoutDialogMode.Rename => "Layout umbenennen",
                _ => "Layout duplizieren"
            };
            <div class="modal-overlay" @onclick="CloseLayoutDialog">
                <div class="modal-dialog" @onclick:stopPropagation>
                    <h3>@dialogTitle</h3>
                    <div class="field">
                        <div class="field-label"><span>Name</span></div>
                        <input type="text" value="@_layoutDialogName"
                               @oninput="e => { _layoutDialogName = e.Value?.ToString() ?? string.Empty; _dialogTouched = true; }"
                               placeholder="Layout-Name" />
                        @if (LayoutDialogHint is not null)
                        {
                            <span class="field-error">@LayoutDialogHint</span>
                        }
                    </div>
                    <div class="modal-actions modal-actions-row">
                        <button class="btn btn-secondary" @onclick="CloseLayoutDialog">Abbrechen</button>
                        <button class="btn btn-primary" @onclick="ConfirmLayoutName"
                                disabled="@(!IsLayoutNameValid)">Speichern</button>
                    </div>
                </div>
            </div>
        }

        @if (_showAddBlockDialog)
        {
            <div class="modal-overlay" @onclick="() => _showAddBlockDialog = false">
                <div class="modal-dialog" @onclick:stopPropagation>
                    <h3>Block hinzufügen</h3>
                    <div class="block-type-list">
                        @foreach (BlockType t in Enum.GetValues<BlockType>())
                        {
                            <button class="block-type-btn" @onclick="() => AddBlock(t)">
                                <span class="icon"><Icon Name="@t.GetDefaultIcon()" Size="18" /></span>
                                <span class="name">@t.GetDisplayName()</span>
                            </button>
                        }
                    </div>
                    <button class="btn btn-secondary" @onclick="() => _showAddBlockDialog = false">Abbrechen</button>
                </div>
            </div>
        }

        @if (_pendingConfirmAction is not null)
        {
            <div class="modal-overlay" @onclick="CancelConfirm">
                <div class="modal-dialog modal-confirm" @onclick:stopPropagation>
                    <h3>@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                    <div class="modal-actions modal-actions-row">
                        <button class="btn btn-secondary" @onclick="CancelConfirm">Abbrechen</button>
                        <button class="btn btn-danger" @onclick="ExecuteConfirm">@_confirmVerb</button>
                    </div>
                </div>
            </div>
        }

        @if (_showAbout)
        {
            <div class="modal-overlay" @onclick="CloseAbout">
                <div class="modal-dialog modal-about" @onclick:stopPropagation>
                    <div class="about-header">
                        <span class="about-logo">📦</span>
                        <div>
                            <h3>relexx' Template Generator</h3>
                            <span class="about-version">Blazor WebAssembly · .NET 8</span>
                        </div>
                    </div>
                    <p class="about-welcome">Mit diesem Tool erstellst du professionelle eBay-Angebotsbeschreibungen als fertigen HTML-Code — direkt im Browser, ohne Installation.</p>
                    <div class="about-features">
                        <div class="about-feature">
                            <span class="about-feature-num">1</span>
                            <div><strong>Layout</strong> — Definiere die Struktur deines Angebots: füge Blöcke (Überschriften, Texte, Bilder, Feature-Listen u. v. m.) hinzu und ordne sie per Drag & Drop.</div>
                        </div>
                        <div class="about-feature">
                            <span class="about-feature-num">2</span>
                            <div><strong>Eingabe</strong> — Fülle jeden Block mit Inhalten: Texte, Bilder und blockspezifische Einstellungen werden direkt bearbeitet.</div>
                        </div>
                        <div class="about-feature">
                            <span class="about-feature-num">3</span>
                            <div><strong>Vorschau</strong> — Sieh dir die Live-Vorschau des generierten Listings an, bevor du exportierst.</div>
                        </div>
                        <div class="about-feature">
                            <span class="about-feature-num">4</span>
                            <div><strong>HTML</strong> — Kopiere oder lade den fertigen HTML-Code herunter und füge ihn direkt in dein eBay-Angebot ein.</div>
                        </div>
                    </div>
                    <div class="about-deps">
                        <span class="about-deps-label">Verwendete Bibliotheken</span>
                        <div class="about-dep"><strong>Blazor WebAssembly</strong> 8.0.27 — .NET-App-Framework im Browser</div>
                        <div class="about-dep"><strong>Markdig</strong> 1.2.0 — Markdown-zu-HTML-Konvertierung</div>
                        <div class="about-dep"><strong>SortableJS</strong> 1.15.0 — Drag & Drop für Blöcke</div>
                        <div class="about-dep"><strong>Lucide</strong> — UI-Icons (App &amp; generiertes HTML)</div>
                        <div class="about-dep"><strong>Geist / Geist Mono</strong> (Google Fonts) — UI-Schriftarten</div>
                    </div>
                    <div class="modal-actions modal-actions-row">
                        <button class="btn btn-primary" @onclick="CloseAbout">Los geht's!</button>
                    </div>
                </div>
            </div>
        }

        @if (_showImportConflict)
        {
            <div class="modal-overlay" @onclick="() => _showImportConflict = false">
                <div class="modal-dialog" @onclick:stopPropagation>
                    <h3>⚠️ Layout-Konflikt</h3>
                    <p>Das importierte Layout unterscheidet sich vom aktuellen.</p>
                    <p><strong>Aktuell:</strong> @currentLayout.Name (@currentLayout.Blocks.Count Blöcke)</p>
                    <p><strong>Import:</strong> @importedArticle?.Layout?.Name (@importedArticle?.Layout?.Blocks.Count Blöcke)</p>

                    <div class="modal-actions">
                        <button class="btn btn-primary" @onclick="ImportWithNewLayout">Layout aus Datei übernehmen</button>
                        <button class="btn btn-secondary" @onclick="ImportKeepLayout">Versuchen, Daten einzupassen</button>
                        <button class="btn btn-secondary" @onclick="() => _showImportConflict = false">Abbrechen</button>
                    </div>
                </div>
            </div>
        }
    };

    private RenderFragment RenderNotification() => __builder =>
    {
        @if (!string.IsNullOrEmpty(_notification))
        {
            <div class="notification @(_notificationSuccess ? "success" : "error") @(_notificationLeaving ? "is-leaving" : "")">@_notification</div>
        }
    };
}
